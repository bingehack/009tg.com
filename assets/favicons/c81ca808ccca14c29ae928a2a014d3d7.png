        <section class="column-content-with-icon-section resource-card-section  default resource-card no-padding-top card-background-white link-style-check">
        <div class="container">
            <div class="column-content-with-icon-inner-section resource-card-inner">
                                    <h3 class="resource-card-heading"><h2 style="text-align:center;">Resources to Take Your SEO to the Next Level</h2></h3>
                                <div class="resource-card-slider-wrapper column-content-with-icon">
                                                <div class="column-content-with-icon__item resource-card__item">
                                <div class="resource-card__header">
                                                                            <div class="resource-card__icon">
                                            <img loading="lazy" decoding="async" width="156" height="142" src="https://www.seo.com/wp-content/uploads/2023/10/orange-lightbulb-icon-on-a-purple-background.png" class=" full" alt="Orange lightbulb icon on a purple background" />                                        </div>
