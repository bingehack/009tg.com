        <style>
            /* Hide CAPTCHA by default - JS will show it on last step */
            .seo-checker-main-header .gform_wrapper .gfield--type-captcha,
            .seo-checker-main-header .gform_wrapper .gfield.gfield--type-captcha,
            .seo-checker-main-header .gform_wrapper .gfield_captcha,
            .seo-checker-main-header .gform_wrapper .gfield[class*="captcha"] {
                display: none !important;
            }
            
            /* Show CAPTCHA when on last step */
            .seo-checker-main-header .gform_wrapper.gf-last-step .gfield--type-captcha,
            .seo-checker-main-header .gform_wrapper.gf-last-step .gfield.gfield--type-captcha,
            .seo-checker-main-header .gform_wrapper.gf-last-step .gfield_captcha,
            .seo-checker-main-header .gform_wrapper.gf-last-step .gfield[class*="captcha"] {
                display: block !important;
            }
            
            /* Hide submit button by default - JS will show it on last step */
            .seo-checker-main-header .gform_wrapper .gform_footer,
            .seo-checker-main-header .gform_wrapper input[type="submit"],
            .seo-checker-main-header .gform_wrapper button[type="submit"],
            .seo-checker-main-header .gform_wrapper .gform_button {
                display: none !important;
            }
            
            /* Show submit button when on last step */
            .seo-checker-main-header .gform_wrapper.gf-last-step .gform_footer,
            .seo-checker-main-header .gform_wrapper.gf-last-step input[type="submit"],
            .seo-checker-main-header .gform_wrapper.gf-last-step button[type="submit"],
            .seo-checker-main-header .gform_wrapper.gf-last-step .gform_button {
                display: block !important;
            }
            
            /* Ensure form wrapper has relative positioning */
            .seo-checker-main-header .gform_wrapper {
                position: relative;
            }
        </style>
        
