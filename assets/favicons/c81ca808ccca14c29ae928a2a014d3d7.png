		<script id="nav-primary-mover">
			var menu = document.querySelector('#ubermenu-initial-container');
			var buttonsBar = document.querySelector('#buttons-bar');
			var mainMenuID = 108;
			if(menu != null && menu.childNodes.length > 0) {
				var desktopNavPrimary = document.querySelector('.ubermenu-nav-primary-wrapper');
				if(desktopNavPrimary != null) {
					var menuItems = menu.childNodes;
					for (var i = 0; i < menuItems.length; i++) {
						desktopNavPrimary.appendChild(menuItems[i]);
					}
				}
			}
			if(buttonsBar != null) {
				buttonsBar.classList.remove('hidden');
			}
			// Hide the search link and add webfx logo if the ubermenu id is 6 (Services menu)
			if(mainMenuID == 108 ) {
				document.querySelector('#buttons-bar .search-link').classList.add('hidden');
				document.querySelector('#buttons-bar .webfx-link').classList.remove('hidden');
			}
		</script>
    
