<div id="lx-ai-cs" class="lx-ai-cs" aria-live="polite">
  <button type="button" class="lx-ai-cs__fab" id="lx-ai-cs-fab" data-i18n-aria-label="aiCsOpenLabel" aria-label="打开 AI 客服" aria-expanded="false" aria-controls="lx-ai-cs-panel">
    <img src="/static/img/customer.png" data-i18n-alt="aiCsAlt" alt="来喜 AI 客服" width="68" height="68" draggable="false">
  </button>

  <div class="lx-ai-cs__panel" id="lx-ai-cs-panel" role="dialog" data-i18n-aria-label="aiCsTitle" aria-label="来喜 AI 客服" aria-hidden="true" hidden>
    <header class="lx-ai-cs__header">
      <div class="lx-ai-cs__header-main">
        <img class="lx-ai-cs__avatar" src="/static/img/customer.png" alt="" width="36" height="36" draggable="false">
        <div class="lx-ai-cs__titles">
          <strong data-i18n="aiCsTitle">来喜 AI 客服</strong>
          <span data-i18n="aiCsSubtitle">常见问题秒回 · 点选或输入提问</span>
        </div>
      </div>
      <button type="button" class="lx-ai-cs__close" id="lx-ai-cs-close" data-i18n-aria-label="aiCsCloseLabel" aria-label="关闭">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3.5 3.5l9 9M12.5 3.5l-9 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    </header>

    <div class="lx-ai-cs__body" id="lx-ai-cs-body">
      <div class="lx-ai-cs__messages" id="lx-ai-cs-messages"></div>
    </div>

    <div class="lx-ai-cs__suggest" id="lx-ai-cs-suggest"></div>

    <form class="lx-ai-cs__composer" id="lx-ai-cs-form" autocomplete="off">
      <input
        type="text"
        id="lx-ai-cs-input"
        class="lx-ai-cs__input"
        data-i18n-placeholder="aiCsPlaceholder"
        placeholder="输入你的问题…"
        maxlength="200"
        enterkeyhint="send"
      >
      <button type="submit" class="lx-ai-cs__send" id="lx-ai-cs-send" data-i18n-aria-label="aiCsSendLabel" aria-label="发送">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M3 9h10.5M9.5 4.5L14.5 9l-5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </form>
  </div>
</div>

