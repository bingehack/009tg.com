<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="来喜投屏是一款免费的电脑控制手机的软件. 可以将手机投屏到电脑,并用鼠标和键盘作为虚拟按键反向控制手机,可以手动也可用自动脚本控制,手机的一切功能均由电脑实现.可在电脑端看视频,文件传输,收发信息等.">
    <meta name="keywords" content="来喜安卓手机群控系统,Android手机控制,安卓手机控制,安卓手机群控,安卓手机群控系统,电脑控制手机,手机自动群控系统,电脑控制安卓手机,电脑远程控制手机,电脑控制多台手机,免费软件,官网免费下载.">
    <title>来喜 - 首页</title>
    <link rel="stylesheet" type="text/css" href="static/css/index.css">
    <link rel="stylesheet" type="text/css" href="static/css/index-md.css">
    <link rel="stylesheet" type="text/css" href="static/css/index-sm.css">
    <link data-n-head="ssr" rel="icon" type="image/x-icon" href="static/logo.ico">

    <script src="./static/js/jquery.min.js"></script>
    <script src="./static/js/store.js?v=2" defer></script>
    <script src="./static/js/translate.js?v=2" defer></script>
    <script src="https://apps.bdimg.com/libs/jquery/2.1.4/jquery.min.js"></script>
    <script>
        const language = "zh-CN";
        $(document).ready(function () {

            console.log(language, '%language')

            handleInit(language)

            window.syncNavLang && window.syncNavLang(language);

            var saveImgUrl = ''

            $(".logo a").append(window.logoSvg)

            $(".li").click(function () {

                const lang = $(this).data("lang");
                setLanguage(lang);

                addItemsWithSvg(bannerTxtValueMap[bannerTxtKeyMap[lang]], 'banner-items', 'item')

                $('.lang-label').text($(this).text());

                $(".li").removeClass("li-active");
                $(this).addClass("li-active");

                handleAboutLang(lang)

                const newUrl = updateHrefWithSearchParams(window.location, {
                    lang
                });
                window.location.href = newUrl;

            });

            function checkIsLaixiPromote() {
                const queryParams = new URLSearchParams(window.location.search);

                if (!queryParams.has('code')) return

                // Step 1: 获取 UA 字符串并判断是否在微信浏览器中
                const userAgent = navigator.userAgent;
                const isWeChat = /MicroMessenger/i.test(userAgent);

                // Step 2: 构建请求的 UA（追加 "WeChatBrowser" 信息，如果是在微信中打开的）
                const customUserAgent = isWeChat ? `${userAgent} WeChatBrowser` : userAgent;
                let baseUrl = 'https://lxapi.neibuapi.com/web/promoCall'
                if (!['zh-TW', 'zh-CN'].includes(language)) baseUrl =
                    'https://lxglobal.neibuapi.com/web/promoCall'

                fetch(`${baseUrl}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'User-Agent': customUserAgent,
                        },
                        body: JSON.stringify({
                            code: queryParams.get('code')
                        }),
                    })
                    .then(response => response.json())
                .then(data => {
                        // console.log('Response:', data);
                })
                .catch(error => {
                        // console.log('Error:', error);
                    })
                    .finally(() => {
                        // const newUrl = updateHrefWithSearchParams(window.location, {
                        //     lang
                        // });
                        // window.location.href = newUrl;
                });

            }


            function handleInit(language) {
                checkIsLaixiPromote()

                setLanguage(language);

                handleAboutLang(language)

                addItemsWithSvg(bannerTxtValueMap[bannerTxtKeyMap[language]], 'banner-items', 'item')

                updateLanguageSelection(language)
            }


            function handleAboutLang(lang) {
                let serviceQrcode = ''

                if (lang === 'zh-CN' || lang === 'zh-TW') {
                    serviceQrcode = 'https://laixiui.cnhack.com/images/newWaterfalls/service-qrcode.png';
                } else {
                    serviceQrcode = 'https://laixiui.cnhack.com/images/newWaterfalls/telegram.png';
                }

                $('.service-qrcode-img').attr('src', serviceQrcode)

                handleChangeMobileLangIcon(lang)

                handleImg(lang)

                updateImages(lang)

                handleShowIntegrated(lang)

                window.setSEO(lang, 'home')


            }

            $('.btn-down').on('click', function (event) {
                event.preventDefault();
                const newUrl = updateHrefWithSearchParams(this);
                window.location.href = newUrl;
            });


            function updateHrefWithSearchParams(element, newParams = {}) {
                const currentSearchParams = new URLSearchParams(window.location.search);

                let href = $(element).attr('href');

                const newHref = new URL(href, window.location.origin);

                currentSearchParams.forEach((value, key) => {
                    newHref.searchParams.set(key, value);
                });

                for (const key in newParams) {
                    newHref.searchParams.set(key, newParams[key]);
                }

                $(element).attr('href', newHref.toString());
                return newHref.toString();
            }


            function handleShowIntegrated(lang) {
                $(".integrated").show();
                $('.zh-txt').show()
                if (lang !== 'zh-CN' && lang !== 'zh-TW') {
                    $(".integrated").hide();
                    $('.zh-txt').hide()
                }
            }

            $(".lang-text").hover(
                function () {
                    $(".language-ul").show();
                },
                function () {
                    $(".language-ul").hide();
                }
            );

            function handleImg(lang) {
                const {
                    saveManagerImgSrc
                } = window.updateImageSources(lang);

                saveImgUrl = saveManagerImgSrc

                const {
                    bannerImgSrc
                } = window.getMainBannerImg(lang)

                $('.save-img').attr('href', saveManagerImgSrc);
                $('.manager-img').attr('src', saveManagerImgSrc);
                $('.main-banner').attr('src', bannerImgSrc);
            }


            $('.link-menu').each(function () {
                let href = $(this).attr('href');
                const newHref = updateHrefWithSearchParams(this);
                $(this).attr('href', newHref.toString());
            });

            $(window).scroll(function () {
                var distanceToBottom = $(document).height() - ($(window).height() + $(window)
                    .scrollTop());
                if (distanceToBottom <= 32) {
                    $('.invite-box').removeClass('invite-box-float');
                } else {
                    $('.invite-box').addClass('invite-box-float');
                }

                var distanceToTop = $(window).scrollTop()
                if (distanceToTop < 1114) {
                    $('.lightspot-menu').removeClass('lightspot-menu-fixed');
                } else {
                    $('.lightspot-menu').show();
                    $('.lightspot-menu').addClass('lightspot-menu-fixed');
                }

                if (distanceToTop > 4700) {
                    $('.lightspot-menu').removeClass('lightspot-menu-fixed');
                }

                var scrollDistance = $(window).scrollTop();
                $('.lightspot-menu .menu-li a').each(function () {
                    if ($(this.hash).offset().top - 100 <= scrollDistance) {
                        $('.lightspot-menu .menu-li').removeClass('menu-li-active');
                        $(this).parent().addClass('menu-li-active');
                    }
                });
            });

            function handleMenuScroll() {
                let menu = document.querySelector('.lightspot-menu');

                if (!menu) return;

                const menuOffsetTop = menu.offsetTop;

                function scrollHandler() {
                    const scrollY = window.scrollY || window.pageYOffset;

                    if (scrollY >= menuOffsetTop) {
                        menu.classList.add('fixed');
                    } else {
                        menu.classList.remove('fixed');
                    }
                }

                scrollHandler();

                window.addEventListener('scroll', scrollHandler);
            }

            handleMenuScroll();

            $('.language').mousemove(function (e) {
                $('.language-ul').show();
            });

            $('.language').mouseout(function (e) {
                $('.language-ul').hide();
            });

            function addItemsWithSvg(str, containerId, liClass) {
                $('#' + containerId).empty();

                var items = str.split(',');

                var svgIcon = window.honePageBannerSvg;

                $.each(items, function (index, value) {
                    $('#' + containerId).append('<li class="' + liClass + '">' + svgIcon + value +
                        '</li>');
                });
            }

            $('.sm-download').on('click', function () {
                window.location.href = 'down';
            });

            $(".sm-lang-icon").on('click', function () {
                $('.lang-menu').toggle();
                $('.sm-menu').hide();
            });
            $(".menu-icon").on('click', function () {
                $('.lang-menu').hide();
                $('.lightspot-menu').hide();
                $('.sm-menu').toggle();
            });


            $(".current-page").on('click', function () {
                $('.lang-menu').hide();
                $('.sm-navigation').toggle();
                $('.lightspot-menu').toggle();
            });

            $('.levitate-service-content').hide()
            $('.lightspot-menu').hide();
            $('.sm-navigation').hide();

            $('.levitate-service-closed').on('click', function () {
                $('.levitate-service-content').hide()
                window.enableScroll()
            });

            $('.levitate-service').on('click', function () {
                $('.levitate-service-content').show()
                window.disableScroll()
            });


            function updateLanguageSelection(language) {
                $(".li").removeClass("li-active");

                const labelText = $('.li[data-lang="' + language + '"]').text().trim().split(' ')[0];
                $('.lang-label').text(labelText);

                $('.li[data-lang="' + language + '"]').addClass("li-active");
            }

            function handleChangeMobileLangIcon(lang) {

                const mobileLangIcon = window.iconMap[lang]

                $('.sm-lang-icon').html(mobileLangIcon);
                $('.lang-menu').hide();
            }


            // 更新瀑布流图片
            function updateImages(lang) {
                const imageElements = document.querySelectorAll('.item-img img');
                imageElements.forEach((img, index) => {
                    const key = index + 1;
                    const {
                        imgSrc
                    } = window.getGifOrPic(lang, key);
                    img.src = imgSrc;
                });
            }


            function updateLinksWithLang() {
                const queryParams = new URLSearchParams(window.location.search);
                const lang = queryParams.get('lang');

                if (lang) {
                    $('.link-menu').each(function () {
                        let href = $(this).attr('href');
                        const newHref = new URL(href, window.location.origin);
                        newHref.searchParams.set('lang', lang);
                        $(this).attr('href', newHref.toString());
                    });
                }
            }

            handleLoadScript()

            function handleLoadScript() {
                window.loadScript('//at.alicdn.com/t/c/font_4260133_o9yejdu3m7.js');
                window.loadScript('https://www.googletagmanager.com/gtag/js?id=AW-11479622774');
                window.loadScript('https://analytics.us.umami.is/script.js', {
                    defer: false,
                    async: true,
                    attributes: {
                    'data-website-id': '6b20e259-b811-4263-8682-f3310bb48554'
                    }
                });
                window.loadScript('https://cloud.umami.is/script.js', {
                    defer: true,
                    async: false,
                    attributes: {
                    'data-website-id': '6b20e259-b811-4263-8682-f3310bb48554'
                    }
                });
            }

        });
    </script>
</head>

<body>

