    //获取token
    function getcookie(objname){ 
		var arrstr = document.cookie.split("; ");
		for(var i = 0;i < arrstr.length;i ++){
			var temp = arrstr[i].split("=");
			if(temp[0] == objname) return unescape(temp[1]);
		}
	}
    //浏览器
    function getBrowser()  
	{  
   		var OsObject = "";  
   		var userAgent = navigator.userAgent;
   		if(userAgent.indexOf("MSIE")>0) {  
      	  return "MSIE";  
   		}else if(userAgent.indexOf("Chrome")>0){  
    	    return "Chrome";  
   		}else if(userAgent.indexOf("Firefox")>0){  
    	    return "Firefox";  
  		}else if(userAgent.indexOf("Safari")>0) {  
        	return "Safari";  
   		} else if(userAgent.indexOf("Camino")>0){  
       		return "Camino";  
   		}else if(userAgent.indexOf("Gecko/")>0){  
        	return "Gecko";  
   		}else{
   			return navigator.appName;
   		}
		}  
    var ssoToken = getcookie("com.vfsso.cas.token")?getcookie("com.vfsso.cas.token"):"";
    var browser = getBrowser();
    $(".zxkf-li a").attr("href","https://cschat.antcloud.com.cn/pcportal.htm?tntInstId=FONIMHCN&scene=SCE00001177");
    
    //阿里云客服替换
    $.ajax({
        url: 'https://ent.kjtpay.com/customer-service/show-dialog.htm',
        type: 'GET',
        dataType: 'JSONP', 
        callback: 'callback',
        jsonp: "callbackparam",
        data: {
          terminal : "web",
          browser: browser, 
          token:ssoToken,
          network: 'wifi' ,
	      contractOrSale:'contract',
	      personalOrEnterprise: 'personal'   
        },
        success: function(data) {
           var url = eval(data).url;
           $(".zxkf-li a").attr("href",url);
        },
        error:function(){
        	$(".zxkf-li a").attr("href","https://cschat.antcloud.com.cn/pcportal.htm?tntInstId=FONIMHCN&scene=SCE00001177");
        }
    });
    
</script>
<script type="text/javascript">
    (function () {
        window._fmOpt = {
            partner: 'kjtpay',
            appName: 'kjtpay_web',
            token: 'site' + "-" + new Date().getTime() + "-" + Math.random().toString(16).substr(2),
            fmb: true,
            success: function (data) {
                // 在成功完成采集后，success回调中可以获取到blackbox
                window.blackbox = data;
                console.log("window.blackbox==", window.blackbox);
                window._fmOpt = {};//置空
                window._fmOpt = {
                    partner: 'kjtpay',
                    appName: 'kjtpay_web',
                    token: 'site' + "-" + new Date().getTime() + "-" + Math.random().toString(16).substr(2),
                    fmb: true,
                    fpHost: 'https://fp.fraudmetrix.cn',
                    staticHost: 'static.fraudmetrix.cn',
                    success: function (data) {
                        // 在成功完成采集后，success回调中可以获取到blackbox
                        window.blackbox = window.blackbox + ";" + data;
                        jQuery.ajax({
                            type: 'POST',
                            data: {"black_box": window.blackbox},
                            url: "/ocx/setSarsBlackBox.htm",
                            success: function (response) {
                                if (response.result == 'success') {
                                    //
                                    //console.log(response);
                                } else {
                                    //console.log("设备指纹设置失败");
                                }
                            },
                            dataType: "json"
                        });
                    },
                };
                var cimg = new Image(1, 1);
                cimg.onload = function () {
                    _fmOpt.imgLoaded = true;
                };
                cimg.src = "https://fp.kjtpay.com/fp/clear.png?partnerCode=kjtpay&appName=kjtpay_web&tokenId=" + window._fmOpt.token;
                var fm = document.createElement('script');
                fm.type = 'text/javascript';
                fm.async = true;
                fm.src = ('https:' == document.location.protocol ? 'https://' : 'http://') + 'static.fraudmetrix.cn/v3/fm.js?ver=0.1&t=' + (new Date().getTime() / 3600000).toFixed(0);
                var s = document.getElementsByTagName('script')[0];
                s.parentNode.insertBefore(fm, s);

            },
            fpHost: 'https://fp.kjtpay.com',//'https://zfp.kjtpay.com',//'https://fp.kjtpay.com',  //TODO...
            staticHost: ''
        };
        var fm = document.createElement('script');
        fm.type = 'text/javascript';
        fm.async = true;
        //fm.src = ('https:' == document.location.protocol ? 'https://' : 'http://') + 'static.fraudmetrix.cn/static/fm.js';
        fm.src = window._fmOpt.fpHost + '/static/fm.js?ver=0.1';

        var s = document.getElementsByTagName('script')[0];
        s.parentNode.insertBefore(fm, s);

    })();
</script>
