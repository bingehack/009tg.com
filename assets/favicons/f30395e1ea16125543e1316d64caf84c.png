<script type="text/javascript">
		var pay_pwd_type = '$paypwdType';

	jQuery.ajax({
	    type: 'POST',
	    url: "/my/getHeaderData.htm" ,
	    success: function(response) {
	    	if(response.success){
	    		var memberType=response.data.membertype;
	    		var personaVerifyLevel=response.data.personaVerifyLevel;
	    		var memberType=response.data.membertype;
	    		var verify_name=response.data.verify_name;
	    		var verify_mobile=response.data.verify_mobile;
	    		var verify_email=response.data.verify_email;
	    		var lastLoginDate=response.data.lastLoginDate;  
	    		var lastIp=response.data.lastIp;  
	    		var reservedMsn=response.data.reservedMsn;
				var lastLoginStatus=response.data.lastLoginStatus;
				var loginName=response.data.loginName;
	    		$("#lastLoginDate").html(lastLoginDate);
	    		$("#lastIp").html(lastIp);
	    		if(reservedMsn!=null){
	    			$("#reservedMsn").html("预留信息："+reservedMsn);
	    		}
	    		$("#loginName").html(loginName);
				$("#lastLoginStatus").html(lastLoginStatus);
	    		//实名认证
	    		if(memberType=='personal'){
	    			if(personaVerifyLevel==null||personaVerifyLevel==''){
	    				$("#persionImg").addClass('un-new');
	    				$("#persionHtml").html("未实名");
	    				$("#persionHtml").width("36px");
	    			}else{
	    				$("#persionHtml").html("实名等级"+personaVerifyLevel);
	    			}
	    		}else{
	    			if(verify_name=='PASS'||verify_name=='checkPass'){
	    				$("#persionHtml").html("已实名");
	    			}else if(verify_name=='checkReject'){
	    				$("#persionImg").addClass('un-new');
	    				$("#persionHtml").html("认证失败");
	    			}else if(verify_name=='init'){
	    				$("#persionImg").addClass('un-new');
	    				$("#persionHtml").html("认证中");
	    			}else{
	    				$("#persionImg").addClass('un-new');
	    				$("#persionHtml").html("未实名");
	    				$("#persionHtml").width("36px");
	    			}
	    		}
	    		
	    		//电话号码
	    		if(verify_mobile==null||verify_mobile==''){
	    			$("#phoneImg").addClass('un-new');
	    			$("#phoneHtml").html("手机未绑定");
	    			$("#phoneHtml").width("60px");
	    		}else{
	    			$("#phoneHtml").html(verify_mobile);
	    		}
	    		
	    		//邮件
	    		if(verify_email==null||verify_email==''){
	    			$("#emailImg").addClass('un-new');
	    			$("#emailHtml").html("邮箱未绑定");
	    			$("#emailHtml").width("60px");
	    		}else{
	    			$("#emailHtml").html(verify_email);
	    		}
	    		
	    		var left_w = $(".accountName-new").width() + 22;
				$(".i-personal-new em,.i-personal-new .i-up-new").css("left", left_w + "px");
				$(".i-personal-new .i-content-new").css("left", left_w - $(".i-personal-new .i-content-new").width()/2 + "px");
				$(".i-phone-new em,.i-phone-new .i-up-new").css("left", left_w + 32 + "px");
				$(".i-phone-new .i-content-new").css("left", left_w + 32 - $(".i-phone-new .i-content-new").width()/2 + "px");
				$(".i-email-new em,.i-email-new .i-up-new").css("left", left_w + 60 + "px");
				$(".i-email-new .i-content-new").css("left", left_w + 60 - $(".i-email-new .i-content-new").width()/2 + "px");
				$(".info-new .img-new").addClass("i-show-new");
				
				$(".info-new .img-new.i-show-new").hover(function(){
					$(".info-new p i").eq($(this).index() - 1).css("visibility", "visible");
				},function(){
					$(".info-new p i").eq($(this).index() - 1).css("visibility", "hidden");
				});
	    		
	    	}  
	    } 
	});
	var linkCode = '';
	$(function() {
		if (!linkCode) {
			return;
		}
		$('.navs-new li').removeClass('active-new');
		$('.navs-new li').each(function() {
			if ($(this)) {
				var aHref = $(this).find('a').attr('href');
				if (aHref != undefined && aHref.indexOf(linkCode) >= 0) {
    				$(this).addClass('active-new');
    			}
			}
		
			if (hasCurLinkCode($(this))) {
				$(this).addClass('active-new');
			}
		});
	});
	
	function hasCurLinkCode(jHoverli) {
		if (!linkCode) {
			return false;
		}
		
		var res = false;
		jHoverli.find('.navs-sub-new dd').removeClass('active-new');
		jHoverli.find('.navs-sub-new a').each(function() {
			var aHref = $(this).attr('href');
			if (aHref != undefined && aHref.indexOf(linkCode) >= 0) {
				$(this).parent().addClass("active-new");
				res = true;
			}
		});
		return res;
	}
	
	
	
	
	
