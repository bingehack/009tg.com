    $(function(){
        var _this = $(".wrap").eq($(".wrap").length - 1),
            _width = $(window).height();
        var _height = _this.height();

        if(_height > 0 && ((555 + _height) < _width && (243 + _height) < _width) ){
            $(".footer").css({
                "width": "100%",
                "position": "absolute",
                "bottom": "0"
            });
        }
        
        $(window).resize(function() {
            _width = $(window).height();
            if(_height > 0 && ((555 + _height) < _width && (243 + _height) < _width) ){
                $(".footer").css({
                    "width": "100%",
                    "position": "absolute",
                    "bottom": "0"
                });
            }else{
                $(".footer").css({
                    "position": "relative"
                });
            }
        });

        _this.resize(function() {
            _height = _this.height();
            if(_height > 0 && ((555 + _height) < _width && (243 + _height) < _width) ){
