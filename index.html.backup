        function calculateItemsPerPage() {
            var windowWidth = $(window).width();
            if (windowWidth > 1400) {
                return 18; // 6列 × 3行
            } else if (windowWidth > 1200) {
                return 12; // 4列 × 3行
            } else if (windowWidth > 992) {
                return 9;  // 3列 × 3行
            } else if (windowWidth > 768) {
                return 6;  // 2列 × 3行
            } else if (windowWidth > 480) {
                return 6;  // 2列 × 3行
            } else {
                return 3;  // 1列 × 3行
            }
        }

