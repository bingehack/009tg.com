        allSitesData['交易所'] = [{"name": "Bitstamp", "url": "https://www.bitstamp.net", "description": "Bitstamp 创立于 2011 年，是历史相当悠久的中心化交易所 (CEX) 之一，服务于全球 100 个以上国家的近 400 万名用户。", "icon": "assets/favicons/c33538169870c41a870358200959b23b.png"}, {"name": "BingX", "url": "https://www.bingx.com", "description": "BingX 提供多样化的产品和服务，包括现货、衍生品、跟单交易和资产管理 - 所有这些都是为满足从初学者到专业人士的用户不断变化的需求而设计的。", "icon": "assets/favicons/a8831a02cc38487840e789508fe1ebc3.png"}, {"name": "Binance TR", "url": "https://www.trbinance.com", "description": "。Binance TR 由位于土耳其伊斯坦布尔的BN Teknoloji运营，旨在于土耳其境内提供一个可买卖加密货币的快速、安全且可靠的平台。该所支持 TRY 法币交易对。", "icon": "assets/favicons/431e92cc068fcdfa7284945c883916c1.png"}, {"name": "Bitget", "url": "https://www.bitget.com", "description": "Bitget 是一家位于塞舌尔的加密货币交易所，为 100 个国家/地区的 2000 多万用户提供支持，专注于复制交易和各种智能交易工具。", "icon": "assets/favicons/cf143393051119340f68de252102734c.png"}, {"name": "MEXC", "url": "https://www.mexc.com", "description": "MEXC成立于 2018 年，是一家采用高性能大宗交易撮合技术的中心化交易所。", "icon": "assets/favicons/ee6828252f343002eb9bd65d4a4a6f02.png"}, {"name": "KuCoin", "url": "https://www.kucoin.com", "description": "KuCoin 是一家加密货币交易所，其创办主旨为“促进全球数字价值的自由流通”。", "icon": "assets/favicons/aef0f3adc4021d0cf3e1988ca4b2ae89.png"}, {"name": "Gate.io", "url": "https://gate.io", "description": "Gate.io 是一家中心化加密货币交易所，用户可在此交易多种加密货币和代币。", "icon": "assets/favicons/d9d1787516a4cf7f64f1f1ac25b793a4.png"}, {"name": "Upbit", "url": "https://upbit.com", "description": "Upbit是韩国交易量最大的加密货币交易所。用户可在该平台上以韩元 (KRW) 交易多种加密货币与比特币对。", "icon": "assets/favicons/1ae80c06b68aa0adcc5e50c1debb6eab.png"}, {"name": "Bybit", "url": "http://www.bybit.com", "description": "Bybit 是一家上架了 100 种以上加密货币、超过100 种加密衍生品合约的中心化交易所 (CEX)。它有 500 万名以上的注册用户。该交易所于2018 年在新加坡成立。它是全球排名前5名的加密衍生品交易所。", "icon": "assets/favicons/9cf24dc5de11ae99eb308ddc9fb08972.png"}, {"name": "OKX", "url": "https://www.okx.com", "description": "OKX 是设立于塞舌尔的加密货币中心化交易所 (CEX) 和钱包平台，服务于全球数百万客户。该交易所提供包括现货和简单期权在内的基本交易，以及包括保证金、期货、永续合同和期权在内的衍生品。", "icon": "assets/favicons/14b3b09827055d509b5b843547681e18.png"}, {"name": "Bitfinex", "url": "https://www.bitfinex.com", "description": "Bitfinex 是一家成立于2012年的加密货币交易所，它以提供高级交易功能和高流动性而在全球交易者中享有盛誉。", "icon": "assets/favicons/6fe77db69c686eb5114c4b831d7c32fc.png"}, {"name": "Kraken", "url": "https://www.kraken.com", "description": "Kraken 提供多样化的交易对，包括各种加密货币与法币之间的交易。它是为数不多的提供加密货币到法币直接交易的平台之一，这使得用户可以方便地将加密货币兑换成美元、欧元等主要货币。", "icon": "assets/favicons/335843e7c8bd3f2f92870f3df2d1d77e.png"}, {"name": "Huobi Global", "url": "https://www.htx.com", "description": "Huobi Global 是一家成立于2013年的国际加密货币交易所，最初起源于中国，后因政策原因迁移至海外，成为全球领先的数字资产交易平台之一。", "icon": "assets/favicons/b5adc24f786619e3478eea814ec32692.png"}, {"name": "Coinbase", "url": "https://www.coinbase.com", "description": "Coinbase 是一家总部位于美国的加密货币交易所，它是最早为用户提供买卖比特币等加密货币服务的平台之一。", "icon": "assets/favicons/d5c5c85e129eb37139f8528b5c71ec3f.png"}, {"name": "Binance", "url": "https://www.binance.com", "description": "Binance 是全球领先的加密货币交易平台之一，以其庞大的交易量、广泛的加密货币交易对选择以及多样化的金融服务而闻名。", "icon": "assets/favicons/c36c86abfb601d334e5797335c2ca5e5.png"}];
        allSitesData['钱包'] = [{"name": "imToken", "url": "https://token.im", "description": "imToken是一款专为移动设备设计的数字资产钱包应用，它支持多种数字资产的存储和管理。", "icon": "assets/favicons/a44d785d8373f78889d4b98e9f811759.png"}, {"name": "Exodus", "url": "https://www.exodus.com", "description": "Exodus 是一款设计精美、操作简便的多加密货币钱包，降低加密货币的使用门槛，使得非技术用户也能轻松安全地管理他们的资产。", "icon": "assets/favicons/cb98d88f10a48dc955cf4a26766543dc.png"}, {"name": "Trust Wallet", "url": "https://trustwallet.com", "description": "Trust Wallet 是一个多功能的移动加密货币钱包，由加密货币交易所 Binance 支持。作为一个开源的移动应用程序，Trust Wallet 为用户提供了存储、发送和接收多种加密货币的功能。", "icon": "assets/favicons/90da835410e6c52e431385a94665fbe9.png"}, {"name": "MetaMask", "url": "https://metamask.io", "description": "MetaMask 是一款流行的加密货币钱包，以浏览器扩展程序和移动应用程序的形式存在，主要用于与以太坊区块链以及基于以太坊的ERC-20代币进行交互。", "icon": "assets/favicons/df5ce09644ad2046a9a37ab0464b24ed.png"}, {"name": "Trezor", "url": "https://trezor.io", "description": "Trezor Model T 和 Trezor One 是由 SatoshiLabs 生产的硬件钱包，它们是用于存储加密货币的物理设备，提供高安全性的冷存储解决方案。", "icon": "assets/favicons/2ab6da9125ae07f8a89df91a013a9d72.png"}, {"name": "Ledger Nano", "url": "https://www.ledger.com", "description": "Ledger Nano S 和 Ledger Nano X 是由 Ledger 公司生产的硬件钱包，专为存储加密货币而设计。硬件钱包被认为是一种冷存储解决方案，因为它们允许用户将其加密资产存储在离线环境中，从而提供了比在线钱包（热存储）更高级别的安全性。", "icon": "assets/favicons/7875c7b3280f6ff579d887512cb8009d.png"}];
