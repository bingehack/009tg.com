# Python
*.py
*.pyc
__pycache__/

# 例外：tools目录下的Python脚本需要同步
!tools/*.py
!tools/crawler/*.py
!tools/web_admin/*.py
!tools/test_scripts/*.py

# 数据文件
*.json
# 例外：主数据文件和favicon映射需要同步
!完整版导航.json
!favicon_mapping.json
!tools/category_translation.json

# 临时文件
*.tmp
*.temp
index_new.html

# 系统文件
.DS_Store
Thumbs.db

# IDE文件
.vscode/
.idea/

# 日志文件
*.log

# 备份文件
*.backup
*.bak
